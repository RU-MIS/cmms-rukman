# Example Nginx reverse-proxy config for the BusinessFlow ERP backend.
#
# Copy to /etc/nginx/sites-available/erp-api on the VM, replace
# api.yourdomain.com with your real domain, then:
#   sudo ln -s /etc/nginx/sites-available/erp-api /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.yourdomain.com   # issues + auto-configures HTTPS
#
# After certbot runs, it rewrites this file to add the SSL certificate
# paths and an HTTP->HTTPS redirect automatically — the block below is the
# starting point before that, plain HTTP on port 80.

server {
    listen 80;
    server_name api.yourdomain.com;

    # PDF/Excel downloads and file uploads can be a few MB — match the
    # backend's own FILE_SIZE_LIMIT_MB (see backend/.env.example).
    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
