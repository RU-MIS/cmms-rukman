# ============================================
# BusinessFlow ERP — Environment Variables
# Copy this file to backend/.env and fill in values.
# NEVER commit the real .env file to git.
# ============================================

# ── App ──────────────────────────────────────
NODE_ENV=development
APP_NAME="BusinessFlow ERP"
COMPANY_NAME="Your Company Pvt Ltd"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ── MySQL ────────────────────────────────────
# Local: install MySQL 8.0+, create a database, then set this.
# Free hosted option: Oracle MySQL HeatWave Always Free.
DATABASE_URL="mysql://root:root@localhost:3306/businessflow_erp"

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_minimum_secret
JWT_EXPIRES_IN=8h

# ── SMTP Email (for sending invoices/receipts as PDF) ─
# Example for Gmail: use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="BusinessFlow ERP <your_email@gmail.com>"

# ── GST Lookup API (optional — for "Fetch GST Details") ─
# Leave blank until you subscribe to a GST verification API. The app shows
# a clear "not configured" state until all three are set; no fake data is
# ever fetched or shown. Set once here and every company benefits — no
# per-company keys, nothing to touch in the frontend.
GST_API_KEY=
GST_API_BASE_URL=
GST_API_PROVIDER=

# ── Security ──────────────────────────────────
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Uploads ───────────────────────────────────
FILE_SIZE_LIMIT_MB=5
UPLOAD_DIR=uploads

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
