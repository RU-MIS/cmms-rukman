# =============================================================================
# Environment for ONE instance. Copy to .env.local (development) or set the
# same keys in the hosting provider (production). Placeholder values only —
# never commit real values. See docs/INSTANCE_ARCHITECTURE.md §3.
# =============================================================================

# --- Instance identity (must equal instance_meta.instance_id in the database)
APP_INSTANCE_ID=change-me-unique-instance-id
APP_ENV=development                      # development | staging | production

# --- Branding (no product name is hard-coded in the code)
NEXT_PUBLIC_APP_NAME="Rukman Dataflow Management System"
NEXT_PUBLIC_APP_SHORT_NAME="Rukman DMS"
NEXT_PUBLIC_PRIMARY_COLOR="#1f4e79"
NEXT_PUBLIC_SECONDARY_COLOR="#f2a900"
NEXT_PUBLIC_LOGO_URL=                   # optional, e.g. /brand/logo.svg (file in web/public/brand/)
NEXT_PUBLIC_FAVICON_URL=                # optional, e.g. /brand/favicon.ico
APP_BASE_URL=http://localhost:3000

# --- Supabase project of THIS instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # worker / backup / scripts only — NEVER in the web host
SUPABASE_URL=https://your-project-ref.supabase.co        # worker / backup (same as NEXT_PUBLIC_SUPABASE_URL)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres   # scripts / backup only — Session pooler URI (IPv4)

# --- Storage: bucket "documents" is created by the migrations (nothing to configure)

# --- Email sender of this instance (server only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=erp@example.com
SMTP_PASSWORD=change-me
EMAIL_FROM_NAME="Company Name"
EMAIL_FROM_ADDRESS=erp@example.com
SMTP_SECURE=false                         # true for port 465

# --- Email worker (worker/; GitHub Actions secrets in production)
WORKER_BATCH_SIZE=20
WORKER_LOOP_INTERVAL_MS=60000

# --- Nightly backup (GitHub secret only)
BACKUP_PASSPHRASE=change-me-long-random
