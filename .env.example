# =============================================================================
# Environment for ONE instance. Copy to .env.local (development) or set the
# same keys in the hosting provider (production). Placeholder values only —
# never commit real values. See docs/INSTANCE_ARCHITECTURE.md §3.
# =============================================================================

# --- Instance identity (must equal instance_meta.instance_id in the database)
APP_INSTANCE_ID=change-me-unique-instance-id
APP_ENV=development                      # development | staging | production

# --- Branding (no product name is hard-coded in the code)
NEXT_PUBLIC_APP_NAME="Rukman Dataflow Management System"
NEXT_PUBLIC_APP_SHORT_NAME="Rukman DMS"
NEXT_PUBLIC_PRIMARY_COLOR="#1f4e79"
NEXT_PUBLIC_SECONDARY_COLOR="#f2a900"
NEXT_PUBLIC_LOGO_URL=/brand/logo.svg
NEXT_PUBLIC_FAVICON_URL=/brand/favicon.ico
APP_BASE_URL=http://localhost:3000

# --- Supabase project of THIS instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # server only
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres   # scripts only

# --- Storage buckets (created per instance)
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_ATTACHMENTS=attachments

# --- Email sender of this instance (server only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=erp@example.com
SMTP_PASSWORD=change-me
EMAIL_FROM_NAME="Company Name"
EMAIL_FROM_ADDRESS=erp@example.com
SMTP_SECURE=false                         # true for port 465

# --- Email worker (worker/; GitHub Actions secrets in production)
WORKER_BATCH_SIZE=20
WORKER_LOOP_INTERVAL_MS=60000
