# ============================================
# BusinessFlow ERP — Environment Variables
# Copy this file to backend/.env and fill in values.
# NEVER commit the real .env file to git.
# ============================================

# ── App ──────────────────────────────────────
# development | staging | production — see the "Production environment
# validation" section of README.md before setting this to production.
# Setting NODE_ENV=production turns on strict startup checks (JWT_SECRET
# strength, CORS_ORIGIN) that fail the boot with a clear error instead of
# starting insecurely.
NODE_ENV=development
APP_NAME="BusinessFlow ERP"
COMPANY_NAME="Your Company Pvt Ltd"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ── MySQL ────────────────────────────────────
# Local: install MySQL 8.0+, create a database, then set this.
# Free hosted option: Oracle MySQL HeatWave Always Free.
DATABASE_URL="mysql://root:root@localhost:3306/businessflow_erp"

# ── JWT Auth ──────────────────────────────────
# REQUIRED in production (NODE_ENV=production) — the server refuses to start
# without it, and rejects anything under 32 characters or a well-known
# placeholder (including the example value below — never use it as-is).
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_32_char_minimum_secret
JWT_EXPIRES_IN=8h

# ── SMTP Email (for sending invoices/receipts as PDF) ─
# Example for Gmail: use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="BusinessFlow ERP <your_email@gmail.com>"

# ── GST Lookup API (optional — for "Fetch GST Details") ─
# Leave blank until you subscribe to a GST verification API. The app shows
# a clear "not configured" state until all three are set; no fake data is
# ever fetched or shown. Set once here and every company benefits — no
# per-company keys, nothing to touch in the frontend.
GST_API_KEY=
GST_API_BASE_URL=
GST_API_PROVIDER=

# ── Security ──────────────────────────────────
# BCRYPT_ROUNDS: 10 is fine for local dev; consider 12 in production (slower
# hashing = slower brute force, at the cost of slightly slower login).
BCRYPT_ROUNDS=10
# CORS_ORIGIN: the exact frontend URL allowed to call this API. REQUIRED in
# production and must NOT be left as localhost — the server refuses to boot
# in production if it still points at localhost (see NODE_ENV above).
CORS_ORIGIN=http://localhost:3000
# General API rate limit (all of /api). Login/password endpoints additionally
# get a much tighter, non-configurable limit (20 requests / 15 min per IP)
# hardcoded in server.ts — not adjustable via env, by design.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Uploads ───────────────────────────────────
FILE_SIZE_LIMIT_MB=5
UPLOAD_DIR=uploads

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug

# ── Automated tests (optional) ────────────────
# Only used by `npm test` (backend/tests). Leave unset and the test suite
# derives one from DATABASE_URL above by appending "_jest_test" to the
# database name (dropped and recreated on every test run) — this can never
# collide with your real dev/demo database. Set this only if you want the
# tests to use a completely different MySQL server.
# TEST_DATABASE_URL=
