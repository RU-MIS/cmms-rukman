# ============================================
# CMMS Rukman Udyog — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ============================================

# ── App ──────────────────────────────────────
NODE_ENV=development
APP_NAME="CMMS Pro"
COMPANY_NAME="Rukman Udyog"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ── PlanetScale MySQL ─────────────────────────
# Get from: planetscale.com → your database → Connect → Node.js
DATABASE_URL="mysql://username:password@host/dbname?ssl={"rejectUnauthorized":true}"
DB_HOST=aws.connect.psdb.cloud
DB_USER=your_planetscale_username
DB_PASSWORD=your_planetscale_password
DB_NAME=cmms_rukman
DB_PORT=3306
DB_SSL=true

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ── Google Drive ──────────────────────────────
# Get from: console.cloud.google.com → Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=cmms@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_root_folder_id

# ── Gmail SMTP ────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM="CMMS Pro <your_email@gmail.com>"

# ── Google Chat Webhook ───────────────────────
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR/messages?key=YOUR_KEY

# ── Security ──────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
