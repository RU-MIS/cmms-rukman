# ============================================
# QR/Barcode Scanner — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================

PORT=4000

# Allow requests from your frontend's origin (dev default shown below).
# In production, set this to your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173

# ── Google Sheets ─────────────────────────────
# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Name of the tab/worksheet inside the spreadsheet (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Service account credentials (from the JSON key file you download in
# Google Cloud Console — see README.md for step-by-step instructions).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
